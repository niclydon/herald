# Bare HW678 V0.0.0 with N16R8, identified via photos and chip/boot queries.
# Keep GPIO0 BOOT and UART console; no guessed onboard RGB LED pin.
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_MODE_QUAD=n
CONFIG_BT_NIMBLE_MEM_ALLOC_MODE_EXTERNAL=y
CONFIG_HOMEHUB_BUTTON_GPIO=0
CONFIG_HOMEHUB_LED_BACKEND_NONE=y
CONFIG_HOMEHUB_OTA_ENABLED=y
CONFIG_HOMEHUB_I2S_SPEAKER=y
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_HOMEHUB_NVS_ENCRYPTION=n
CONFIG_SECURE_BOOT=n
CONFIG_FLASH_ENCRYPTION_ENABLED=n
CONFIG_HOMEHUB_PAIRING_EFUSE_AUTH=n
